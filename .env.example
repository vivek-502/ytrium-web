# ---------------------------------------------------------------------------
# Ytrium environment configuration
# Copy this file to `.env` (in the repository root for the server) and adjust.
# Never commit real secrets.
# When running the packaged binary (installed via install.sh), configure the
# service with `Environment=` lines instead - see README "Configuration".
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the backend API listens on.
PORT=8787
# Interface to bind. 0.0.0.0 exposes the server on all interfaces (dev and
# production alike); the default keeps it loopback-only.
HOST=127.0.0.1
NODE_ENV=development

# Comma separated list of allowed CORS origins (used by the API when the
# frontend is served from a different origin, e.g. Vite dev server).
CORS_ORIGIN=http://localhost:5173

# --- yt-dlp -----------------------------------------------------------------
# Path to the yt-dlp executable (absolute path recommended in production).
YTDLP_PATH=yt-dlp
# Hard timeout for every yt-dlp invocation (ms).
YTDLP_TIMEOUT_MS=30000
# Number of results returned per search query.
YTDLP_SEARCH_LIMIT=20
# Extra CLI arguments passed to yt-dlp (comma separated), e.g. a proxy.
# YTDLP_EXTRA_ARGS=

# --- Streaming --------------------------------------------------------------
# proxy  -> the API proxies media bytes (hides upstream URLs, handles expiry)
# redirect -> the API replies with a temporary redirect to the media URL
STREAM_MODE=proxy
# Maximum time (ms) a resolved media URL is considered fresh. Resolved URLs
# are NEVER persisted - only kept in the in-memory TTL cache.
STREAM_TTL_MS=1800000

# --- Cache (all in-memory, TTL based) ---------------------------------------
SEARCH_CACHE_TTL_MS=600000
METADATA_CACHE_TTL_MS=86400000
CHART_CACHE_TTL_MS=1800000
RECOMMENDATION_CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=500

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SEARCH_PER_MIN=40
RATE_LIMIT_STREAM_PER_MIN=60
RATE_LIMIT_API_PER_MIN=300
# Password checks per minute: sign-in, credential changes, admin deletes.
RATE_LIMIT_AUTH_PER_MIN=20

# --- Accounts & sessions ----------------------------------------------------
# Local-first multi-user sign-in (username + password). Accounts live in
# DATA_DIR/users.json, sessions in DATA_DIR/sessions.json - both gitignored.
# On first run an `admin` / `admin` account is created; change that password
# from Settings. Passwords are stored only as salted scrypt hashes; an admin
# can create users (password set once, at creation) and delete users (which
# requires that user's password) but can never read or reset a password.
# Days a signed-in session stays valid.
SESSION_TTL_DAYS=30
# Override where users.json / sessions.json are stored. Defaults to
# server/data in a checkout, or ~/.local/share/ytrium-web (XDG) in the binary.
# DATA_DIR=/path/to/data

# --- Providers --------------------------------------------------------------
# Charts/metadata provider (trending, popular, new releases). Uses Apple's
# public iTunes RSS + lookup APIs (metadata only - no media is streamed from
# them). Disable to fall back to yt-dlp search derived charts.
ENABLE_CHARTS_PROVIDER=true
CHARTS_API_BASE=https://itunes.apple.com
CHARTS_REGION=us

# --- Lyrics -----------------------------------------------------------------
# Lyrics come from the public LRCLIB API (no key required) with a fallback to
# the current track's YouTube captions when LRCLIB has no entry. Lyrics are
# treated as metadata and cached in-memory; they are never written to disk.
ENABLE_LYRICS_PROVIDER=true
LYRICS_API_BASE=https://lrclib.net
# Timeout for a single lyrics database lookup (ms).
LYRICS_TIMEOUT_MS=10000
# Timeout for the yt-dlp caption fallback download (ms).
LYRICS_SUBS_TIMEOUT_MS=12000
# How long "lyrics found: none" is remembered so missed tracks are not
# re-queried constantly (ms).
LYRICS_CACHE_TTL_MS=86400000
LYRICS_CACHE_MAX_ENTRIES=400
